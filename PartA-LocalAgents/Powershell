Used docker hub to download the latest images for Ollama and OpenClaw also pull from cmd:
docker pull ollama/ollama
docker pull openclaw/openclaw

Using Docker to run Ollama on Windows:

docker volume create ollama


docker run -d \
  --name ollama \
  -p 127.0.0.1:11434:11434 \
  -v ollama:/root/.ollama \
  ollama/ollama

docker exec -it ollama ollama run qwen3:0.6b
docker exec -it ollama ollama run qwen3:1.7b

docker stop ollama
docker start ollama


Test ollama version, models and functionality:
curl.exe http://localhost:11434/api/version
curl.exe http://localhost:11434/api/tags
$body = @{
    model = "qwen3:0.6b"
    prompt = "What is 5 + 7? Reply with only the number."
    stream = $false
    think = $false
} | ConvertTo-Json

$response = Invoke-RestMethod `
    -Uri "http://localhost:11434/api/generate" `
    -Method Post `
    -ContentType "application/json" `
    -Body $body

$response.response

Docker Network:

docker network create ai-network
docker network connect ai-network ollama

Using Docker to run OpenClaw on Windows:

# $token = [guid]::NewGuid().ToString("N")
# $token | Set-Content "$HOME\.openclaw-gateway-token"
# $token = (Get-Content "$HOME\.openclaw-gateway-token" -Raw).Trim()

docker volume create openclaw

seting up OpenClaw to use local gateway mode and bind to LAN:

docker run --rm `
  -v openclaw:/home/node/.openclaw `
  --entrypoint node `
  openclaw/openclaw `
  dist/index.js config set gateway.mode local


docker run --rm `
  -v openclaw:/home/node/.openclaw `
  --entrypoint node `
  openclaw/openclaw `
  dist/index.js config set gateway.bind lan

Running OpenClaw:

docker run -d `
  --name openclaw `
  --network ai-network `
  --restart unless-stopped `
  --init `
  -p 127.0.0.1:18789:18789 `
  -e OLLAMA_API_KEY=ollama-local `
  -v openclaw:/home/node/.openclaw `
  --entrypoint node `
  openclaw/openclaw `
  dist/index.js gateway --bind lan --port 18789


Setup:

$tokenFile = "$HOME\.openclaw-gateway-token"; if (Test-Path $tokenFile) { $token = (Get-Content $tokenFile -Raw).Trim() } else { $token = [guid]::NewGuid().ToString("N"); Set-Content $tokenFile $token }; docker run --rm -it `
  --network ai-network `
  -v openclaw:/home/node/.openclaw `
  -e OPENCLAW_GATEWAY_TOKEN=$token `
  -e OLLAMA_API_KEY=ollama-local `
  --entrypoint node `
  openclaw/openclaw `
  dist/index.js onboard --mode local --no-install-daemon

